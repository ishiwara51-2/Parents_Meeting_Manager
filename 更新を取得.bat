@echo off
setlocal
cd /d "%~dp0"

echo ==============================
echo  最新版を取得します（git pull）
echo ==============================
echo.

git pull
if %errorlevel% neq 0 (
    echo.
    echo ==============================
    echo  更新の取得に失敗しました。上のエラー内容を確認してください。
    echo ==============================
    pause
    exit /b 1
)

echo.
echo ==============================
echo  更新の取得が完了しました。
echo  「ビルドして起動.bat」でアプリを起動し直してください。
echo ==============================
pause
